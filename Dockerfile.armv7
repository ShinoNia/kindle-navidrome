FROM --platform=linux/arm/v7 ubuntu:14.04

ENV DEBIAN_FRONTEND=noninteractive

ENV PATH="/opt/python-3.7.5/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ============================================================
# Ubuntu 14.04 repositories
# ============================================================

RUN sed -i \
        's|http://archive.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
        /etc/apt/sources.list \
    && sed -i \
        's|http://security.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
        /etc/apt/sources.list


# ============================================================
# Runtime / development libraries
#
# These come from Ubuntu rather than being cross-compiled.
# ============================================================

RUN apt-get update \
    && apt-get install -y \
        ca-certificates \
        curl \
        wget \
        git \
        make \
        gcc \
        g++ \
        pkg-config \
        zlib1g \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libncurses5-dev \
        libncursesw5-dev \
        libffi-dev \
        liblzma-dev \
        tk-dev \
        tcl-dev \
        libx11-6 \
        libx11-dev \
        libxext6 \
        libxext-dev \
        libxrender1 \
        libxrender-dev \
        libxft2 \
        libxft-dev \
        libjpeg-dev \
        libpng12-dev \
        libfreetype6-dev \
        libflac-dev \
        libflac8 \
        file \
        binutils \
    && rm -rf /var/lib/apt/lists/*


# ============================================================
# Cross-compiled OpenSSL
# ============================================================

COPY cross/opt/openssl-1.1.1 /opt/openssl-1.1.1

ENV OPENSSL_ROOT=/opt/openssl-1.1.1


# ============================================================
# Cross-compiled Python
# ============================================================

COPY cross/opt/python-3.7.5 /opt/python-3.7.5


# ============================================================
# Runtime library search path
# ============================================================

ENV LD_LIBRARY_PATH="/opt/openssl-1.1.1/lib:/opt/python-3.7.5/lib"


# ============================================================
# Python verification
# ============================================================

RUN /opt/python-3.7.5/bin/python3 --version \
    && /opt/python-3.7.5/bin/python3 -c \
        "import ssl; print(ssl.OPENSSL_VERSION)" \
    && /opt/python-3.7.5/bin/python3 -c \
        "import platform; print(platform.machine())" \
    && /opt/python-3.7.5/bin/python3 -c \
        "import struct; print(str(struct.calcsize('P') * 8) + '-bit')"


# ============================================================
# pip
# ============================================================

RUN /opt/python-3.7.5/bin/python3 -m ensurepip \
    && /opt/python-3.7.5/bin/python3 -m pip install \
        --upgrade \
        "pip<24" \
        "setuptools<70" \
        wheel


# ============================================================
# Application workspace
# ============================================================

WORKDIR /src

CMD ["/bin/bash"]
