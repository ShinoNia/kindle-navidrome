FROM --platform=linux/arm/v7 ubuntu:14.04

ENV DEBIAN_FRONTEND=noninteractive

ENV PATH="/opt/python-3.7.5/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ============================================================
# Ubuntu 14.04 repositories
# ============================================================

RUN sed -i \
        's|http://archive.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
        /etc/apt/sources.list \
    && sed -i \
        's|http://security.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
        /etc/apt/sources.list


# ============================================================
# Ubuntu ARMv7 dependencies
# ============================================================

RUN apt-get update \
    && apt-get install -y \
        build-essential \
        ca-certificates \
        curl \
        wget \
        git \
        make \
        gcc \
        g++ \
        patch \
        pkg-config \
        file \
        binutils \
        \
        zlib1g \
        zlib1g-dev \
        \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        \
        libncurses5-dev \
        libncursesw5-dev \
        \
        libffi-dev \
        liblzma-dev \
        \
        tcl8.6 \
        tcl8.6-dev \
        tk8.6 \
        tk8.6-dev \
        \
        libx11-6 \
        libx11-dev \
        libxext6 \
        libxext-dev \
        libxrender1 \
        libxrender-dev \
        libxft2 \
        libxft-dev \
        \
        libjpeg-dev \
        libpng12-dev \
        libfreetype6-dev \
        \
        libflac8 \
        libflac-dev \
    && rm -rf /var/lib/apt/lists/*


# ============================================================
# CROSS-COMPILED OPENSSL
# ============================================================

COPY openssl-armv7 /opt/openssl-1.1.1

ENV OPENSSL_ROOT=/opt/openssl-1.1.1


# ============================================================
# Python source
# ============================================================

WORKDIR /tmp

RUN wget \
        https://www.python.org/ftp/python/3.7.5/Python-3.7.5.tgz \
    && tar -xzf Python-3.7.5.tgz


# ============================================================
# Build Python ARMv7
#
# This still runs through QEMU.
#
# However, the expensive OpenSSL build no longer does.
# ============================================================

WORKDIR /tmp/Python-3.7.5

RUN export CPPFLAGS="-I/opt/openssl-1.1.1/include" \
    && export CFLAGS="-I/opt/openssl-1.1.1/include" \
    && export LDFLAGS="-L/opt/openssl-1.1.1/lib -Wl,-rpath,/opt/openssl-1.1.1/lib" \
    && export LD_RUN_PATH="/opt/openssl-1.1.1/lib" \
    && ./configure \
        --prefix=/opt/python-3.7.5 \
        --with-openssl=/opt/openssl-1.1.1 \
    && make -j4 \
    && make install


# ============================================================
# Clean source
# ============================================================

RUN rm -rf \
        /tmp/Python-3.7.5 \
        /tmp/Python-3.7.5.tgz


# ============================================================
# Verify Python
# ============================================================

RUN /opt/python-3.7.5/bin/python3 --version \
    && /opt/python-3.7.5/bin/python3 -c \
        "import ssl; print(ssl.OPENSSL_VERSION)" \
    && /opt/python-3.7.5/bin/python3 -c \
        "import platform; print(platform.machine())" \
    && /opt/python-3.7.5/bin/python3 -c \
        "import struct; print(str(struct.calcsize('P') * 8) + '-bit')"


# ============================================================
# pip
# ============================================================

RUN /opt/python-3.7.5/bin/python3 -m ensurepip \
    && /opt/python-3.7.5/bin/python3 -m pip install \
        --upgrade \
        "pip<24" \
        "setuptools<70" \
        wheel


# ============================================================
# NumPy / Pillow
#
# These are intentionally built inside ARMv7.
# ============================================================

RUN /opt/python-3.7.5/bin/python3 -m pip install numpy pillow


# ============================================================
# Workspace
# ============================================================

WORKDIR /src

CMD ["/bin/bash"]
